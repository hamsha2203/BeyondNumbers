# Optional: set up Google Sheets integration after the UI is running.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Use a random high-entropy secret with at least 32 characters for signed PM sessions.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Set the PM-only password on the server; do not use a NEXT_PUBLIC_ variable.
PM_ADMIN_PASSWORD=
